generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model user {
  user_id       Int            @id @default(autoincrement())
  f_name        String?        @db.VarChar(45)
  l_name        String?        @db.VarChar(45)
  email         String         @unique(map: "email_UNIQUE") @db.VarChar(90)
  password      String         @db.VarChar(60)
  refresh_token String?        @db.VarChar(255)
  category      category[]
  item          item[]
  activity      activity[]
  notification  notification[]
}

model category {
  category_id        Int     @id @default(autoincrement())
  name               String  @db.VarChar(45)
  description        String? @db.VarChar(200)
  allocation_percent Float   @default(0)
  user_id            Int?
  user               user?   @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "fc_user_id")
  item               item[]

  @@index([user_id], map: "user_id_idx")
}

model item {
  item_id            Int        @id @default(autoincrement())
  name               String     @db.VarChar(45)
  description        String?    @db.VarChar(200)
  cost               Float?
  balance            Float?     @default(0)
  allocation_percent Float      @default(0)
  status             String     @default("ACTIVE") @db.VarChar(20)
  category_id        Int?
  user_id            Int?
  category           category?  @relation(fields: [category_id], references: [category_id], onDelete: Cascade, map: "category_id")
  user               user?      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "ic_user_id")
  activity           activity[]

  @@index([category_id], map: "category_id_idx")
  @@index([user_id], map: "user_id_idx")
}

model activity {
  activity_id Int      @id @default(autoincrement())
  user_id     Int
  item_id     Int?
  type        String   @db.VarChar(40)
  amount      Float?
  metadata    Json?
  created_at  DateTime @default(now())
  user        user     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "activity_user_id")
  item        item?    @relation(fields: [item_id], references: [item_id], onDelete: SetNull, map: "activity_item_id")

  @@index([user_id], map: "activity_user_id_idx")
  @@index([item_id], map: "activity_item_id_idx")
}

model notification {
  notification_id Int       @id @default(autoincrement())
  user_id         Int
  code            String    @db.VarChar(80)
  message         String    @db.VarChar(255)
  read_at         DateTime?
  created_at      DateTime  @default(now())
  user            user      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "notification_user_id")

  @@index([user_id], map: "notification_user_id_idx")
}
