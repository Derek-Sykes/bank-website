# Backend .env

# Prisma/MySQL connection
# Preferred connection string used by Prisma migrations and Prisma Client.
DATABASE_URL="mysql://your_mysql_user:your_mysql_password@localhost:3306/bank_app"

# Legacy MySQL connection variables are still accepted by the backend as a fallback
# when DATABASE_URL is not set.
MYSQL_HOST=localhost
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=bank_app

# JWT secrets
ACCESS_TOKEN=your_access_token_secret
REFRESH_TOKEN=your_refresh_token_secret
