# Backend .env

# MySQL connection
MYSQL_HOST=localhost
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
# IMPORTANT: must be bank_app unless you edit queries that fully-qualify the schema
MYSQL_DATABASE=bank_app
DATABASE_URL="mysql://your_mysql_user:your_mysql_password@localhost:3306/bank_app"

# JWT secrets
ACCESS_TOKEN=your_access_token_secret
REFRESH_TOKEN=your_refresh_token_secret
